{
  "name": "@cairn/extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite build --watch",
    "build": "vite build && node scripts/copy-static.mjs",
    "test": "vitest run",
    "pretest:e2e": "pnpm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cairn/adapters": "workspace:*",
    "@cairn/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "vite": "^8.2.0"
  }
}
